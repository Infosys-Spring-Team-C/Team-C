# ---------------------------------------------------------------------------
# SalesGenie AI backend - example environment file.
# Copy to .env and replace every placeholder. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
SALES_GENIE_ENV=development

# --- Database --------------------------------------------------------------
# Local SQLite (default if DATABASE_URL is unset) is convenient for a quick
# start, but PostgreSQL is the canonical target.
# DATABASE_URL=sqlite:///./salesgenie.db
DATABASE_URL=postgresql+psycopg://salesgenie:CHANGE_ME_DB_PASSWORD@localhost:5432/salesgenie

# Used by docker-compose.yml only.
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- Authentication --------------------------------------------------------
AUTH_ENABLED=true
# Required when AUTH_ENABLED=true. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=120

# --- Browser clients (Maheksaba's Streamlit app) ---------------------------
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Intelligence layer ----------------------------------------------------
# heuristic = deterministic, offline, no credentials (default).
# external  = adapter for the reviewed ai.* package (requires its PR to be merged).
SALES_GENIE_AI_BACKEND=heuristic
SALES_GENIE_LLM_PROVIDER=mock
SALES_GENIE_LLM_MODEL=
SALES_GENIE_LLM_TEMPERATURE=0.2
SALES_GENIE_AI_TIMEOUT_SECONDS=20
SALES_GENIE_MAX_TRANSCRIPT_CHARS=42000

# Provider credentials (only needed for SALES_GENIE_LLM_PROVIDER != mock).
GROK_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Limits ----------------------------------------------------------------
MAX_CSV_BYTES=5000000
MAX_CSV_ROWS=5000
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
SALES_GENIE_SCORE_THRESHOLD_QUALIFIED=70
SALES_GENIE_SCORE_THRESHOLD_NURTURE=45

# --- CRM (planned integration, SRS D-06) -----------------------------------
# No live transport is implemented; these are read only to report configuration
# state on GET /api/v1/crm/providers.
SALESFORCE_ACCESS_TOKEN=
HUBSPOT_ACCESS_TOKEN=
